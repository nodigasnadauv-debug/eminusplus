{
  "$schema": "https://design-tokens.github.io/format/#/definitions/Token",
  "typography": {
    "fontFamily": {
      "display": { "$value": "\"Inter Variable\", system-ui, sans-serif", "$type": "fontFamily" },
      "body": { "$value": "\"Inter Variable\", system-ui, sans-serif", "$type": "fontFamily" },
      "mono": { "$value": "\"JetBrains Mono Variable\", ui-monospace, monospace", "$type": "fontFamily" }
    },
    "fontWeight": {
      "light": { "$value": 300, "$type": "fontWeight" },
      "regular": { "$value": 400, "$type": "fontWeight" },
      "medium": { "$value": 500, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight" },
      "bold": { "$value": 700, "$type": "fontWeight" }
    },
    "fontSize": {
      "fluid": {
        "xs": { "$value": "clamp(0.75rem, 0.7rem + 0.25vw, 0.875rem)", "$type": "dimension" },
        "sm": { "$value": "clamp(0.875rem, 0.825rem + 0.25vw, 1rem)", "$type": "dimension" },
        "md": { "$value": "clamp(1rem, 0.925rem + 0.375vw, 1.125rem)", "$type": "dimension" },
        "lg": { "$value": "clamp(1.125rem, 1.025rem + 0.5vw, 1.25rem)", "$type": "dimension" },
        "xl": { "$value": "clamp(1.25rem, 1.1rem + 0.75vw, 1.5rem)", "$type": "dimension" },
        "2xl": { "$value": "clamp(1.5rem, 1.25rem + 1.25vw, 2rem)", "$type": "dimension" },
        "3xl": { "$value": "clamp(1.875rem, 1.5rem + 1.875vw, 2.5rem)", "$type": "dimension" },
        "4xl": { "$value": "clamp(2.25rem, 1.75rem + 2.5vw, 3.5rem)", "$type": "dimension" },
        "5xl": { "$value": "clamp(3rem, 2rem + 5vw, 5rem)", "$type": "dimension" }
      },
      "display": {
        "xs": { "$value": "3.052rem", "$type": "dimension" },
        "sm": { "$value": "3.815rem", "$type": "dimension" },
        "md": { "$value": "4.768rem", "$type": "dimension" },
        "lg": { "$value": "5.96rem", "$type": "dimension" },
        "xl": { "$value": "7.451rem", "$type": "dimension" }
      },
      "heading": {
        "xs": { "$value": "1.953rem", "$type": "dimension" },
        "sm": { "$value": "2.441rem", "$type": "dimension" },
        "md": { "$value": "3.052rem", "$type": "dimension" },
        "lg": { "$value": "3.815rem", "$type": "dimension" },
        "xl": { "$value": "4.768rem", "$type": "dimension" }
      },
      "body": {
        "xs": { "$value": "0.8rem", "$type": "dimension" },
        "sm": { "$value": "0.875rem", "$type": "dimension" },
        "md": { "$value": "1rem", "$type": "dimension" },
        "lg": { "$value": "1.125rem", "$type": "dimension" },
        "xl": { "$value": "1.25rem", "$type": "dimension" }
      },
      "label": {
        "xs": { "$value": "0.75rem", "$type": "dimension" },
        "sm": { "$value": "0.8125rem", "$type": "dimension" },
        "md": { "$value": "0.875rem", "$type": "dimension" },
        "lg": { "$value": "1rem", "$type": "dimension" }
      },
      "code": {
        "xs": { "$value": "0.75rem", "$type": "dimension" },
        "sm": { "$value": "0.8125rem", "$type": "dimension" },
        "md": { "$value": "0.875rem", "$type": "dimension" },
        "lg": { "$value": "1rem", "$type": "dimension" }
      }
    },
    "lineHeight": {
      "tight": { "$value": 1.1, "$type": "number" },
      "snug": { "$value": 1.375, "$type": "number" },
      "normal": { "$value": 1.5, "$type": "number" },
      "relaxed": { "$value": 1.625, "$type": "number" },
      "display": { "$value": 1.05, "$type": "number" },
      "heading": { "$value": 1.2, "$type": "number" },
      "body": { "$value": 1.6, "$type": "number" },
      "label": { "$value": 1.4, "$type": "number" },
      "code": { "$value": 1.6, "$type": "number" }
    },
    "letterSpacing": {
      "tight": { "$value": "-0.03em", "$type": "dimension" },
      "normal": { "$value": "0", "$type": "dimension" },
      "wide": { "$value": "0.02em", "$type": "dimension" },
      "wider": { "$value": "0.1em", "$type": "dimension" },
      "display": { "$value": "-0.02em", "$type": "dimension" },
      "heading": { "$value": "-0.01em", "$type": "dimension" },
      "body": { "$value": "0", "$type": "dimension" },
      "label": { "$value": "0.005em", "$type": "dimension" }
    }
  }
}
